# Everything here is optional. Copy to .env (git-ignored); `make run` and `docker run --env-file` load it.
# Keep comments on their own lines: Docker does not strip trailing comments from values.

# Claude writes the decision memo. The decision itself never depends on it.
# The server's key is ignored unless AGENTLEDGER_SERVER_LLM=true, so a public deployment
# cannot spend your key by accident. Visitors can always paste their own key in the UI.
ANTHROPIC_API_KEY=
AGENTLEDGER_SERVER_LLM=false
AGENTLEDGER_MODEL=claude-sonnet-5-5

# Limits (defaults shown).
# POSTs per client per minute; 0 disables.
AGENTLEDGER_RATE_LIMIT_PER_MIN=20
# Simultaneous runs before the server answers 503.
AGENTLEDGER_MAX_CONCURRENT=25
# Seconds before a run is aborted, and before the Claude call is abandoned.
AGENTLEDGER_PIPELINE_TIMEOUT=45
AGENTLEDGER_LLM_TIMEOUT=20
AGENTLEDGER_MAX_BODY_BYTES=16384
# false removes the demo delay between agents.
AGENTLEDGER_ALLOW_PACING=true

# Set true ONLY behind a reverse proxy you control that sets X-Forwarded-For.
AGENTLEDGER_TRUST_PROXY=false

LOG_LEVEL=INFO
